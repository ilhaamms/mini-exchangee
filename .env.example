# ─── Server ───────────────────────────────────────────
PORT=8080

# ─── JWT ──────────────────────────────────────────────
# Ganti dengan secret key yang kuat di production
JWT_SECRET=your-secret-key-here

# ─── PostgreSQL ───────────────────────────────────────
POSTGRES_ENABLED=false
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-password-here
POSTGRES_DB=mini_exchange
POSTGRES_SSLMODE=disable

# ─── Redis ────────────────────────────────────────────
REDIS_ENABLED=false
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# ─── NATS ─────────────────────────────────────────────
NATS_ENABLED=false
NATS_URL=nats://localhost:4222

# ─── Finnhub Real Feed ────────────────────────────────
# Kalau true, pakai data real dari Finnhub WebSocket (butuh API key)
# Kalau false, pakai price simulator (random walk)
# Daftar gratis di https://finnhub.io/ untuk mendapatkan API key
FINNHUB_ENABLED=false
FINNHUB_API_KEY=your-finnhub-api-key-here
